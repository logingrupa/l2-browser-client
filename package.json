{
	"name": "l2-browser-client",
	"version": "0.1.0",
	"description": "Browser client for Lineage II Interlude on Babylon.js WebGPU",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": "10.32.1"
	},
	"type": "module",
	"private": true,
	"scripts": {
		"start": "pnpm dev",
		"dev": "node scripts/stage-webgpu-compilers.mjs && vite --host 127.0.0.1",
		"build": "node scripts/stage-webgpu-compilers.mjs && pnpm typecheck && vite build",
		"generate:editor": "node scripts/ensure-webgpu-project.mjs && node scripts/stage-webgpu-compilers.mjs && node scripts/validate-editor-materials.mjs && node scripts/preserve-native-editor-uv2.mjs && babylonjs-editor-cli pack && node scripts/preserve-native-editor-fog.mjs && node scripts/share-native-terrain-export-materials.mjs",
		"renderer:ensure": "node scripts/ensure-webgpu-project.mjs",
		"serve": "vite preview --host 127.0.0.1",
		"preview:private": "node scripts/private-preview.mjs",
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:editor": "vitest run --config vitest.editor.config.ts",
		"test:e2e": "playwright test",
		"test:setup": "playwright install chromium",
		"assets:stage": "python -B scripts/stage_native_players.py",
		"assets:catalog": "python scripts/native_catalog.py",
		"assets:migrate": "python scripts/native_migration.py",
		"assets:pipeline": "python -B scripts/native_batch.py",
		"assets:editor": "node scripts/native_editor_import.mjs",
		"assets:effects": "python scripts/native_effects.py",
		"assets:sounds": "python -B scripts/export-native-sounds.py",
		"assets:convert": "python scripts/native_assets.py convert",
		"assets:batch": "python scripts/native_assets.py batch",
		"assets:verify": "python scripts/native_assets.py verify",
		"test:pipeline": "python scripts/test_pipeline.py",
		"convert:tables": "python -B scripts/data/convert_tables.py",
		"convert:world": "python -B scripts/world/convert_tile.py",
		"convert:actors": "python -B scripts/actors/convert_actors.py",
		"convert:ui": "python -B scripts/data/convert_ui.py",
		"report:coverage": "python -B scripts/native_store/build_coverage_report.py"
	},
	"dependencies": {
		"@babylonjs/addons": "9.27.1",
		"@babylonjs/core": "9.27.1",
		"@babylonjs/gui": "9.27.1",
		"@babylonjs/gui-editor": "9.27.1",
		"@babylonjs/inspector": "9.27.1",
		"@babylonjs/loaders": "9.27.1",
		"@babylonjs/materials": "9.27.1",
		"@babylonjs/node-editor": "9.27.1",
		"@babylonjs/node-geometry-editor": "9.27.1",
		"@babylonjs/node-particle-editor": "9.27.1",
		"@babylonjs/node-render-graph-editor": "9.27.1",
		"@babylonjs/serializers": "9.27.1",
		"@fluentui-contrib/react-resize-handle": "0.8.4",
		"@fluentui-contrib/react-virtualizer": "1.0.0",
		"@fluentui/react-components": "9.75.1",
		"@fluentui/react-icons": "2.0.345",
		"@fluentui/react-motion-components-preview": "0.15.10",
		"@fluentui/react-utilities": "9.27.0",
		"@fontsource-variable/cormorant-garamond": "5.3.0",
		"babylonjs-editor-tools": "5.5.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"usehooks-ts": "3.1.1"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@recast-navigation/core": "0.43.0",
		"@recast-navigation/generators": "0.43.0",
		"@types/node": "22.19.15",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"babylonjs-editor-cli": "5.5.3",
		"esbuild": "0.28.2",
		"gltf-validator": "2.0.0-dev.3.10",
		"l2-editor-webgpu-compat": "file:tools\\editor-webgpu-compat",
		"typescript": "7.0.2",
		"vite": "7.3.7",
		"vitest": "5.1.0"
	}
}
