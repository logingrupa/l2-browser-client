{
	"name": "l2-browser-client",
	"version": "0.1.0",
	"description": "Synthetic, Editor-authored Babylon.js client foundation",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": "10.32.1"
	},
	"type": "module",
	"private": true,
	"scripts": {
		"start": "pnpm dev",
		"dev": "pnpm generate && vite --host 127.0.0.1",
		"build": "pnpm generate && pnpm typecheck && vite build",
		"generate": "babylonjs-editor-cli pack",
		"serve": "vite preview --host 127.0.0.1",
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:setup": "playwright install chromium"
	},
	"dependencies": {
		"@babylonjs/core": "9.27.1",
		"@babylonjs/gui": "9.27.1",
		"@babylonjs/loaders": "9.27.1",
		"@fontsource-variable/cormorant-garamond": "5.3.0",
		"babylonjs-editor-tools": "5.5.3"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "22.19.15",
		"babylonjs-editor-cli": "5.5.3",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vite": "7.3.7",
		"vitest": "5.1.0"
	}
}
