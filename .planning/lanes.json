{
  "schemaVersion": 1,
  "rules": {
    "maximumParallelLanes": 3,
    "branchPattern": "<part>/<slug>",
    "unclaimedPathOwner": "integration",
    "sharedByAllLanes": [
      "tests/browser/**",
      "tests/fixtures/**",
      "tests/pipeline/**",
      "tests/support/**",
      "tests/unit/**"
    ]
  },
  "lanes": {
    "world": {
      "title": "L1 world",
      "parts": ["world", "minimap", "movement-geodata"],
      "owns": [
        "docs/parts/minimap/**",
        "docs/parts/movement-geodata/**",
        "docs/parts/world/**",
        "recipes/native-20-20-placement-audio.json",
        "recipes/native-environment.inputs.json",
        "recipes/native-terrain-textures.json",
        "recipes/world/**",
        "scripts/bundle-native-placement-audio.py",
        "scripts/export-native-environment.py",
        "scripts/measure-native-world.mjs",
        "scripts/native_environment.py",
        "scripts/vendor/lineage2elbera_bsp/**",
        "scripts/world/**",
        "src/scene/world/**"
      ]
    },
    "actors": {
      "title": "L2 actors",
      "parts": ["player-characters", "npcs", "items", "skills-effects", "audio"],
      "owns": [
        "docs/parts/audio/**",
        "docs/parts/items/**",
        "docs/parts/npcs/**",
        "docs/parts/player-characters/**",
        "docs/parts/skills-effects/**",
        "recipes/actors/**",
        "recipes/native-combat-audio.json",
        "recipes/native-equipment.json",
        "recipes/native-ffighter-equipment.json",
        "recipes/native-ffighter.json",
        "recipes/native-fmagic.json",
        "recipes/native-human-footstep-audio.json",
        "recipes/native-human-mystic-footstep-audio.json",
        "recipes/native-human-mystic-footstep-events.json",
        "recipes/native-mfighter.json",
        "recipes/native-mmagic.json",
        "recipes/native-musveren.json",
        "recipes/native-npc-profiles.json",
        "recipes/native-pipeline-ffighter-equipment.json",
        "recipes/native-pipeline-ffighter.json",
        "recipes/native-pipeline-fmagic.json",
        "recipes/native-pipeline-magic.inputs.lock.json",
        "recipes/native-pipeline-mmagic.json",
        "recipes/native-player-aliases-stage.json",
        "recipes/native-player-ffighter-stage.json",
        "recipes/native-player-mfighter-base.json",
        "recipes/native-player-mystics-stage.json",
        "recipes/native-power-strike-audio.json",
        "recipes/native-power-strike.json",
        "recipes/native-sounds-staged.json",
        "recipes/native-stepsound-surfaces.json",
        "scripts/actors/**",
        "scripts/audit-native-footstep-config.py",
        "scripts/audit_musveren_weights.py",
        "scripts/bundle-native-animation-audio.py",
        "scripts/bundle-native-combat-audio.py",
        "scripts/bundle-native-skill-audio.py",
        "scripts/bundle-native-stepsound-package.py",
        "scripts/inspect-native-effect-bundle.py",
        "scripts/inventory-native-footstep-events.py",
        "scripts/native_actor_profiles.py",
        "scripts/native_animation_families.py",
        "scripts/native_effect_bundle.py",
        "scripts/native_effect_registration.mjs",
        "scripts/prepare-native-player-aliases.py",
        "scripts/report-native-animation-aliases.py",
        "scripts/test_effect_readiness.py",
        "src/animation/**",
        "src/assets/native/**",
        "src/audio/**",
        "src/effects/**"
      ]
    },
    "data-ui": {
      "title": "L3 data and UI",
      "parts": ["data", "ui", "sandbox"],
      "owns": [
        "docs/parts/data/**",
        "docs/parts/sandbox/**",
        "docs/parts/ui/**",
        "recipes/data/**",
        "scripts/build_dat_table_inventory.py",
        "scripts/data/**",
        "scripts/native_catalog/**",
        "src/ui/**"
      ]
    },
    "integration": {
      "title": "Integration",
      "parts": ["adapter-login", "adapter-dispatch", "combat-display", "npc-dialogs", "shops-trade", "social", "quests", "late-systems"],
      "owns": [
        ".planning/**",
        "AGENTS.md",
        "DECISIONS.md",
        "README.md",
        "STATUS.md",
        "docs/parts/adapter-dispatch/**",
        "docs/parts/adapter-login/**",
        "docs/parts/combat-display/**",
        "docs/parts/late-systems/**",
        "docs/parts/npc-dialogs/**",
        "docs/parts/quests/**",
        "docs/parts/shops-trade/**",
        "docs/parts/social/**",
        "package.json",
        "pnpm-lock.yaml",
        "scripts/audit-material-census.py",
        "scripts/export-native-sounds.py",
        "scripts/native_assets.py",
        "scripts/native_assets_lib/**",
        "scripts/native_batch.py",
        "scripts/native_catalog.py",
        "scripts/native_editor_import.mjs",
        "scripts/native_effects.py",
        "scripts/native_migration.py",
        "scripts/stage-native-effect.mjs",
        "scripts/stage-native-environment.mjs",
        "scripts/stage-webgpu-compilers.mjs",
        "scripts/stage_native_animation_audio.py",
        "scripts/stage_native_combat_audio.py",
        "scripts/stage_native_players.py",
        "scripts/stage_native_runtime.py",
        "scripts/stage_native_stepsound_package.py",
        "src/materials/**",
        "src/net/**",
        "src/runtime/**",
        "src/scene/getWorldCanvas.ts",
        "src/scene/guardSceneStartup.ts",
        "src/scene/loadEnvironment.ts",
        "src/scene/prepareSceneForReveal.ts",
        "src/scene/projectPosition.ts",
        "src/shared/**",
        "src/world/**",
        "tools/net-relay/**",
        "tools/reference-overlap/**"
      ]
    }
  }
}
